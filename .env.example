# Copie en .env (jamais versionné) et remplis. Les valeurs vides prennent le défaut indiqué.

# Mot de passe de la base, utilisé par docker-compose.yml.
POSTGRES_PASSWORD=
# Sans Docker : postgres://utilisateur:mot-de-passe@hôte/base (défaut postgres://kraken:kraken@127.0.0.1/kraken)
DATABASE_URL=
# Adresse d'écoute (défaut 127.0.0.1:8080 ; 0.0.0.0:8080 dans l'image Docker)
KRAKEN_ADDR=
# Adresse publique, pour les liens des e-mails ; https:// active les cookies Secure
KRAKEN_PUBLIC_URL=
# Dossier du client web construit (défaut crates/kraken-client/dist)
KRAKEN_WEB_DIR=
# SMTP de ton fournisseur, ex. smtps://utilisateur:mot-de-passe@smtp.exemple.org:465 ; vide = pas d'e-mail
KRAKEN_SMTP_URL=
# Expéditeur, ex. KRAKEN <no-reply@exemple.org>
KRAKEN_SMTP_FROM=
# 1 derrière un proxy inverse (IP lue dans X-Forwarded-For)
KRAKEN_TRUST_PROXY=
# Essais de connexion, inscription et e-mail par minute et par IP (défaut 20)
KRAKEN_AUTH_PER_MIN=
# 1 pour charger les comptes et serveurs de démonstration dans une base vide
KRAKEN_SEED=
