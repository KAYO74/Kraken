# Pour docker compose : copie en .env (jamais versionné) et remplis. Sans Docker, le serveur ne
# lit pas ce fichier : exporte les variables (DATABASE_URL, KRAKEN_PUBLIC_URL…) dans le shell.

# Domaine de l'instance, sans https:// (ex. chat.exemple.org). Son enregistrement DNS A doit
# pointer sur ce serveur avant le premier démarrage, pour le certificat HTTPS.
KRAKEN_DOMAIN=
# Mot de passe de la base (long et aléatoire : openssl rand -base64 32)
POSTGRES_PASSWORD=

# E-mails (vérification d'adresse, mot de passe oublié). Vide = pas d'e-mail.
# SMTP de ton fournisseur, ex. smtps://utilisateur:mot-de-passe@smtp.exemple.org:465
KRAKEN_SMTP_URL=
# Expéditeur (défaut : KRAKEN <no-reply@KRAKEN_DOMAIN>)
KRAKEN_SMTP_FROM=

# Pages Confidentialité et Conditions : comment te joindre, et tes sous-traitants
# (ex. « Hetzner, hébergement, Allemagne ; Brevo, e-mails, France »).
KRAKEN_CONTACT=
KRAKEN_PROCESSORS=
# Code source affiché aux utilisateurs (AGPL) ; défaut : le dépôt officiel
KRAKEN_SOURCE_URL=

# Essais de connexion, inscription et e-mail par minute et par client (défaut 20)
KRAKEN_AUTH_PER_MIN=
# 1 pour charger les comptes et serveurs de démonstration dans une base vide
KRAKEN_SEED=

# Sans Docker seulement :
# DATABASE_URL=postgres://kraken:kraken@127.0.0.1/kraken
# KRAKEN_ADDR=127.0.0.1:8080
# KRAKEN_PUBLIC_URL=https://chat.exemple.org
# KRAKEN_WEB_DIR=crates/kraken-client/dist
# KRAKEN_TRUST_PROXY=1   (derrière un proxy inverse qui ajoute X-Forwarded-For)
