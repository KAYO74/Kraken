# Pour docker compose. Le plus simple : `sh install.sh`, qui écrit .env tout seul. À la main :
# copie ce fichier en .env (jamais versionné), remplis, puis `docker compose up -d`. Sans Docker,
# le serveur ne lit pas ce fichier : exporte les variables (DATABASE_URL, KRAKEN_PUBLIC_URL…).

# Domaine de l'instance, sans https:// (ex. chat.exemple.org) : HTTPS automatique. Son
# enregistrement DNS A doit pointer sur ce serveur, et les ports 80 et 443 être ouverts (plus
# le port UDP des salons vocaux, KRAKEN_RTC_PORT).
# Sans domaine : laisse vide et remplis KRAKEN_PUBLIC_URL (instance en HTTP simple).
KRAKEN_DOMAIN=
# Adresse ouverte dans le navigateur. Défaut : https://KRAKEN_DOMAIN. Sans domaine, l'adresse
# de cette machine sur ton réseau, ex. http://192.168.1.20 (avec :8080 si KRAKEN_HTTP_PORT=8080).
KRAKEN_PUBLIC_URL=
# Ports ouverts sur cette machine (défaut 80 et 443). Avec un domaine, garde 80 et 443.
KRAKEN_HTTP_PORT=
KRAKEN_HTTPS_PORT=
# Mot de passe de la base, long et aléatoire (ex. openssl rand -hex 24). Ne le change plus ensuite.
POSTGRES_PASSWORD=
# Salons vocaux (voix et partage d'écran) : le son et l'image passent en UDP sur ce port, qui doit
# être joignable par les navigateurs (pare-feu, hébergeur, redirection sur la box). Défaut 3478.
KRAKEN_RTC_PORT=
# Adresses IPv4 de cette machine annoncées aux navigateurs pour le vocal, séparées par des virgules
# (ex. 203.0.113.7). Vide : celles du domaine ou de KRAKEN_PUBLIC_URL, et celles du réseau local.
KRAKEN_RTC_IPS=
# Port UDP vu de l'extérieur, s'il diffère de KRAKEN_RTC_PORT (redirection de port sur la box).
KRAKEN_RTC_PUBLIC_PORT=
# Image de KRAKEN (défaut : ghcr.io/kayo74/kraken:latest, publiée par la CI). Introuvable : dans
# un clone du dépôt, docker compose la construit depuis le code source.
KRAKEN_IMAGE=

# E-mails (vérification d'adresse, mot de passe oublié). Vide = pas d'e-mail.
# SMTP de ton fournisseur, ex. smtps://utilisateur:mot-de-passe@smtp.exemple.org:465
KRAKEN_SMTP_URL=
# Expéditeur (défaut : KRAKEN <no-reply@KRAKEN_DOMAIN>)
KRAKEN_SMTP_FROM=

# Pages Confidentialité et Conditions : comment te joindre, et tes sous-traitants
# (ex. « Hetzner, hébergement, Allemagne ; Brevo, e-mails, France »).
KRAKEN_CONTACT=
KRAKEN_PROCESSORS=
# Code source affiché aux utilisateurs (AGPL) ; défaut : le dépôt officiel
KRAKEN_SOURCE_URL=

# Essais de connexion, inscription et e-mail par minute et par client (défaut 20)
KRAKEN_AUTH_PER_MIN=
# 1 pour charger les comptes et serveurs de démonstration dans une base vide
KRAKEN_SEED=

# Sans Docker seulement :
# DATABASE_URL=postgres://kraken:kraken@127.0.0.1/kraken
# KRAKEN_ADDR=127.0.0.1:8080
# KRAKEN_PUBLIC_URL=https://chat.exemple.org
# KRAKEN_WEB_DIR=crates/kraken-client/dist
# KRAKEN_TRUST_PROXY=1   (derrière un proxy inverse qui ajoute X-Forwarded-For)
# KRAKEN_RTC_PORT=3478   (UDP, sur toutes les interfaces ; 0 = n'importe quel port libre)
