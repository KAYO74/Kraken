{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KRAKEN",
  "identifier": "org.kraken.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Messagerie libre et auto-hébergeable",
    "copyright": "KRAKEN, AGPL-3.0-or-later",
    "resources": {
      "../../crates/kraken-client/dist/": "client/"
    },
    "icon": [
      "../../replica/brand/icons/icon.png",
      "../../replica/brand/icons/32x32.png",
      "../../replica/brand/icons/128x128.png",
      "../../replica/brand/icons/128x128@2x.png",
      "../../replica/brand/icons/icon.icns",
      "../../replica/brand/icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0MzczRTY0NDZCOTMxQjkKUldTNU1ibEdaRDQzbElHeWpneS83YU8vL0o0dTVDZ3RWbGdUL1BycU9aOFhwb0ovcjNWMFlkakMK",
      "endpoints": [
        "https://github.com/KAYO74/Kraken/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
